# ==========================================
# MOCS E-COMMERCE FRONTEND ENVIRONMENT CONFIG
# Copy this file to .env before starting dev or build
# ==========================================

# Backend API Base URL
# Local development: http://localhost:5000
# Production deployment: https://api.mocs.in (or your backend domain)
VITE_API_BASE_URL=http://localhost:5000

# Razorpay Payment Gateway Key ID
# Test: rzp_test_xxxxxxxxxxxxxx
# Production: rzp_live_xxxxxxxxxxxxxx
VITE_RAZORPAY_KEY_ID=your_razorpay_key_id_here

# Google OAuth Client ID (Optional)
VITE_GOOGLE_CLIENT_ID=your_google_client_id_here
